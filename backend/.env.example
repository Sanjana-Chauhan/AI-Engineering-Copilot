# Copy this file to .env and fill in real values.

# Required
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional — override the Gemini model used for chat/explain/debug/tools
GEMINI_MODEL=gemini-3.6-flash

# Optional — where ChromaDB and the conversation history SQLite file live
CHROMA_DB_PATH=./data/chroma
CONVERSATIONS_DB_PATH=./data/conversations.db

# Optional — sentence-transformers embedding model used for indexing
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
